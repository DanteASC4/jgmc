-examples#center-label","content":"The `centerLabel` option allows you to place a label in the center of the donut chart, which can be used to show a title or other value."},"436":{"id":"/docs/vanilla-examples/donutchart-examples-19","page_id":"/docs/vanilla-examples/donutchart-examples","tags":[],"type":"text","url":"/docs/vanilla-examples/donutchart-examples#center-label","content":"If you set the `centerLabel` option to `\"sum\"` the center label will show the sum of the data values:"},"437":{"id":"/docs/vanilla-examples/donutchart-examples-20","page_id":"/docs/vanilla-examples/donutchart-examples","tags":[],"type":"text","url":"/docs/vanilla-examples/donutchart-examples#center-label","content":"**Adjusting center label styles**"},"438":{"id":"/docs/vanilla-examples/donutchart-examples-21","page_id":"/docs/vanilla-examples/donutchart-examples","tags":[],"type":"text","url":"/docs/vanilla-examples/donutchart-examples#center-label","content":"There are a couple options that allow for adjustment of common title text styles for the center label."},"439":{"id":"/docs/vanilla-examples/donutchart-examples-22","page_id":"/docs/vanilla-examples/donutchart-examples","tags":[],"type":"text","url":"/docs/vanilla-examples/donutchart-examples#center-label","content":"`centerLabelFontSize`"},"440":{"id":"/docs/vanilla-examples/donutchart-examples-23","page_id":"/docs/vanilla-examples/donutchart-examples","tags":[],"type":"text","url":"/docs/vanilla-examples/donutchart-examples#center-label","content":"defaults to `32`"},"441":{"id":"/docs/vanilla-examples/donutchart-examples-24","page_id":"/docs/vanilla-examples/donutchart-examples","tags":[],"type":"text","url":"/docs/vanilla-examples/donutchart-examples#center-label","content":"`centerLabelFontWeight`"},"442":{"id":"/docs/vanilla-examples/donutchart-examples-25","page_id":"/docs/vanilla-examples/donutchart-examples","tags":[],"type":"text","url":"/docs/vanilla-examples/donutchart-examples#center-label","content":"defaults to 